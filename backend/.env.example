# Copy to backend/.env and adjust. All keys are optional.

# GitHub token raises the search rate limit from 10 to 30 requests/minute.
# If omitted, the app falls back to GITHUB_TOKEN, then to `gh auth token`.
# HUB_GITHUB_TOKEN=ghp_...

# Hugging Face token (only needed for higher rate limits or gated content).
# HUB_HF_TOKEN=hf_...

# How many days back to look for new items, and how often to refresh.
HUB_LOOKBACK_DAYS=45
HUB_REFRESH_HOURS=6
HUB_REFRESH_ON_STARTUP=true
